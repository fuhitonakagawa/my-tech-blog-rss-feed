# 必須: 使用する翻訳プロバイダー。ローカルのArgosを使用する。
TRANSLATION_PROVIDER=argos
# 必須: 翻訳バッチ全体のタイムアウト（ミリ秒）。
TRANSLATION_TIMEOUT_MS=1200000
# 必須: Argosの英日モデルを保存するディレクトリ。
ARGOS_PACKAGES_DIR=.argos/packages
# 必須: Argosの補助データ・ダウンロード・設定を保存するディレクトリ。
ARGOS_RUNTIME_DIR=.argos/runtime
# 必須: CPU推論で使用するスレッド数。
TRANSLATION_CPU_THREADS=2
# 必須: PythonブリッジのJSONログレベル。ログは標準エラーへ出力する。
LOG_LEVEL=INFO
