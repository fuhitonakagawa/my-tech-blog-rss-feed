{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:monthly",
    'group:allNonMajor'
  ],
  "timezone": "Asia/Tokyo",
  "rangeStrategy": "bump",
  "dependencyDashboard": false,
  "labels": ["dependencies", "renovate"],
  // ビルドは外部フィードを処理し、書き込み権限を持つワークフローから実行されるため、
  // 依存の更新は人が内容を確認してからマージする
  "automerge": false,
  // 公開直後のパッケージを取り込まないよう様子見期間を設ける
  "minimumReleaseAge": '14 days',
  // GitHub Actions とコンテナイメージは可変タグではなく不変の参照に固定する
  "pinDigests": true,
  "packageRules": [
    {
      matchDepTypes: ['peerDependencies'],
      enabled: false,
    },
  ],
  "ignoreDeps": [
    "node",
  ]
}
