        <id>https://aws.amazon.com/jp/about-aws/whats-new/2026/11/moonshot-ai-kimi-k3-1-pro-on-amazon-bedrock</id>
        <link href="https://aws.amazon.com/jp/about-aws/whats-new/2026/11/moonshot-ai-kimi-k3-1-pro-on-amazon-bedrock"/>
